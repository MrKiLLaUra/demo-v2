# =============================================================================
# Sambi Top Gear Motors — environment variables
# Copy this file to .env.local for local dev, and add the same keys in your
# host (Vercel → Project → Settings → Environment Variables) for production.
# Never commit real values. NEXT_PUBLIC_* keys are exposed to the browser.
# =============================================================================

# --- Database & car inventory (REQUIRED) ------------------------------------
# Supabase project that stores cars, inquiries, bookings, car_requests, and the
# "car-images" storage bucket. Without these the site runs in demo mode (one
# placeholder car) and forms are silently no-ops.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Contact form (REQUIRED for the Contact page form) ----------------------
# Get a free access key at https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key

# --- Lead notifications by email (RECOMMENDED) ------------------------------
# So you actually receive inquiries/bookings/sourcing requests. https://resend.com
RESEND_API_KEY=your_resend_api_key
ALERT_EMAIL_TO=sambitopgearmotors@gmail.com
ALERT_EMAIL_FROM=Sambi Leads <onboarding@resend.dev>

# --- Lead notifications by WhatsApp (OPTIONAL) ------------------------------
# Twilio WhatsApp. Leave blank to skip WhatsApp alerts.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ALERT_WHATSAPP_TO=whatsapp:+35799929323

# --- AI chat assistant & AI price engine (REQUIRED for AI features) ---------
# https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key

# --- Chat rate limiting (OPTIONAL) ------------------------------------------
# Upstash Redis. If unset, the AI chat still works but without rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Heatmaps & session recordings (OPTIONAL) -------------------------------
# Microsoft Clarity. Loads only after the visitor accepts cookies. Create a
# project at https://clarity.microsoft.com and paste the project ID here.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
